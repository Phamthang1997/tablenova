{
  "productName": "TableNova",
  "version": "0.1.0",
  "identifier": "com.tablenova.app",
  "build": {
    "beforeDevCommand": "npm run vite-dev",
    "beforeBuildCommand": "npm run build-frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TableNova",
        "width": 1240,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#1c1c1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
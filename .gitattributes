# Normalize line endings: all text files use LF in repo and working directory.
# Windows development project; without this, each machine commits differently depending on core.autocrlf.
* text=auto eol=lf

# Batch scripts: cmd.exe requires CRLF to execute properly.
*.bat text eol=crlf

# Binary files — no conversion, no diff.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
*.db binary
*.sqlite binary
*.gz binary
*.dump binary
